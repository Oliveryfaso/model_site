{
  "compilerOptions": {
    "target": "ES2022",
    "composite": true,
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "scripts", "tests", "src/content", "src/app/siteConfig.ts"]
}
